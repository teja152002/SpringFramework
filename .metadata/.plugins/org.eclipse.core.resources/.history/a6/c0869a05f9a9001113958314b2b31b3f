package com.spring.student.controller;

import org.springframework.stereotype.Controller;

import com.spring.student.entity.Student;
import com.spring.student.service.StudentService;

@Controller
public class StudentController {
	//@Autowired // ->This process make spring automatically injects the studentService
	private StudentService studentService;
	public StudentController(StudentService studentService) {
		this.studentService = studentService;
	}

	public Student addStudent(Student student) {
		return studentService.addStudent(student);
	}

	public Student findById(int stu_id) {
		return studentService.findById(stu_id);
	}

	public Student updateById(Student student) {
		return studentService.updateById(student);
	}
	
	public Student deleteById(int stu_id) {
		
