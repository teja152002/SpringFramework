<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>Update Employee</title>
</head>
<body>
    <h2>Employee Update Form</h2>
<table>
<tr th:each="emp : ${employees}">
    <td th:text="${emp.empId}"></td>
    <td th:text="${emp.empName}"></td>
    <td th:text="${emp.empEmail}"></td>
    <td th:text="${emp.empDesignation}"></td>

    <td>
        <a th:href="@{/employees/edit/{id}(id=${emp.empId})}">
            Update
        </a>
    </td>
</tr>
</table>
    <form th:action="@{/updateSave}"
          th:object="${employee}"
          method="post">
          
        <label>Id:</label>
        <input type="number" th:field="*{empId}">
        <br><br>

        <label>Name:</label>
        <input type="text" th:field="*{empName}">
        <br><br>

        <label>Email:</label>
        <input type="email" th:field="*{empEmail}">
        <br><br>

        <label>Designation:</label>
        <input type="text" th:field="*{empDesignation}">
        <br><br>

        <button type="submit">Submit</button>

    </form>

</body>
</html>