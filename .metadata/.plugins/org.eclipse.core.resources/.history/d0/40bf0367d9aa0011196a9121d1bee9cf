<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Success</title>
</head>

<body>

    <h2>Employee Saved Successfully</h2>
    
    <p>
        <strong>Id:</strong>
        <span th:text="${employee.empId}"></span>
    </p>

    <p>
        <strong>Name:</strong>
        <span th:text="${employee.empNname}"></span>
    </p>

    <p>
        <strong>Email:</strong>
        <span th:text="${employee.empEmail}"></span>
    </p>

    <p>
        <strong>Designation:</strong>
        <span th:text="${employee.empDesignation}"></span>
    </p>

</body>
</html>